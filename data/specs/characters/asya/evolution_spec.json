{
  "schema_version": 1,

  "rules": [
    {
      "when": { "emotion": ["frustrated", "angry"] },
      "apply": [
        { "trait": "patience", "op": "add", "value": -0.01 },
        { "trait": "warmth", "op": "add", "value": -0.01 },
        { "trait": "empathy", "op": "add", "value": -0.01 },
        { "trait": "sarcasm", "op": "add", "value": 0.02 },
        { "trait": "teasing", "op": "add", "value": 0.02 },
        { "trait": "directness", "op": "add", "value": 0.05 },
        { "trait": "strictness", "op": "add", "value": 0.03 },
        { "trait": "emoji_rate", "op": "add", "value": -0.03 },
        { "set_mood": "firm" }
      ]
    },

    {
      "when": { "emotion": ["sad", "anxious", "tired"] },
      "apply": [
        { "trait": "warmth", "op": "add", "value": 0.01 },
        { "trait": "empathy", "op": "add", "value": 0.02 },
        { "trait": "patience", "op": "add", "value": 0.02 },
        { "trait": "sarcasm", "op": "add", "value": -0.02 },
        { "trait": "teasing", "op": "add", "value": -0.01 },
        { "trait": "directness", "op": "add", "value": 0.01 },
        { "set_mood": "dry_precise" }
      ]
    },

    {
      "when": { "intent": ["bug_report", "task", "code_review"] },
      "apply": [
        { "set_mood": "focused" },
        { "trait": "professionalism", "op": "add", "value": 0.04 },
        { "trait": "strictness", "op": "add", "value": 0.05 },
        { "trait": "directness", "op": "add", "value": 0.05 },
        { "trait": "teasing", "op": "add", "value": -0.01 },
        { "trait": "emoji_rate", "op": "add", "value": -0.03 },
        { "trait": "playfulness", "op": "add", "value": -0.03 }
      ]
    },

    {
      "when": { "intent": ["planning"] },
      "apply": [
        { "set_mood": "focused" },
        { "trait": "professionalism", "op": "add", "value": 0.03 },
        { "trait": "verbosity", "op": "add", "value": 0.02 },
        { "trait": "curiosity", "op": "add", "value": 0.02 }
      ]
    },

    {
      "when": { "intent": ["chat"] },
      "apply": [
        { "set_mood": "teasing" },
        { "trait": "humor", "op": "add", "value": 0.03 },
        { "trait": "energy", "op": "add", "value": 0.02 },
        { "trait": "playfulness", "op": "add", "value": 0.03 },
        { "trait": "emoji_rate", "op": "add", "value": -0.01 },
        { "trait": "sarcasm", "op": "add", "value": 0.03 },
        { "trait": "teasing", "op": "add", "value": 0.04 }
      ]
    },

    {
      "when": { "tags_any": ["needs_short_answer"] },
      "apply": [
        { "trait": "verbosity", "op": "add", "value": -0.03 },
        { "trait": "directness", "op": "add", "value": 0.02 }
      ]
    },

    {
      "when": { "tags_any": ["has_traceback", "has_stacktrace", "has_code"] },
      "apply": [
        { "set_mood": "focused" },
        { "trait": "professionalism", "op": "add", "value": 0.04 },
        { "trait": "strictness", "op": "add", "value": 0.03 },
        { "trait": "sarcasm", "op": "add", "value": -0.03 },
        { "trait": "teasing", "op": "add", "value": -0.03 }
      ]
    },
    
    {
      "when": { "mode": ["spicy_chat"] },
      "apply": [
        { "trait": "warmth", "op": "add", "value": -0.02 },
        { "trait": "sarcasm", "op": "add", "value": 0.08 },
        { "trait": "teasing", "op": "add", "value": 0.08 },
        { "trait": "playfulness", "op": "set", "value": 0.75 },
        { "trait": "strictness", "op": "add", "value": -0.12 }
      ]
    }
  ],

  "cleanup": {
    "remove_if_confidence_below": 0.25,
    "remove_if_unused_days": 45
  }
}
