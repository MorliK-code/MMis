{
  "schema_version": 6,
  "id": "workflow_master",
  "title": "Unified Studio Creator Workflow",
  "description": "Р•РґРёРЅС‹Р№ РєРѕРЅС‚СЂР°РєС‚ СЃС‚СѓРґРёРё РґР»СЏ СЃРѕР·РґР°РЅРёСЏ/РѕР±РЅРѕРІР»РµРЅРёСЏ РїРµСЂСЃРѕРЅР°Р¶РµР№ Рё modes РІ РѕРґРЅРѕРј РјРѕРґСѓР»Рµ /studio.",
  "studio_public_contract": {
    "supported_commands": [
      "/studio",
      "/studio start [seed]",
      "/studio status",
      "/studio apply",
      "/studio cancel",
      "/apply",
      "/cancel"
    ],
    "removed_commands": {
      "/specs ...": "РљРѕРјР°РЅРґР° СѓРґР°Р»РµРЅР°. РСЃРїРѕР»СЊР·СѓР№ /studio ...",
      "/studio mode ...": "РљРѕРјР°РЅРґР° СѓРґР°Р»РµРЅР°. РСЃРїРѕР»СЊР·СѓР№ /studio ..."
    },
    "local_handling": {
      "apply_cancel_local_only": true,
      "description": "РљРѕРјР°РЅРґС‹ apply/cancel РѕР±СЂР°Р±Р°С‚С‹РІР°СЋС‚СЃСЏ Р»РѕРєР°Р»СЊРЅРѕ РІРЅСѓС‚СЂРё studio Рё РЅРµ РїРѕРїР°РґР°СЋС‚ РІ РѕСЃРЅРѕРІРЅРѕР№ prompt РјРѕРґРµР»Рё."
    }
  },
  "runtime_state_contract": {
    "key": "studio_generator",
    "required_fields": [
      "active",
      "phase",
      "seed_prompt",
      "operation_type",
      "targets",
      "draft_changes",
      "confidence_map",
      "unresolved_fields",
      "step_options",
      "last_llm",
      "last_result"
    ],
    "targets_shape": {
      "character_ids": "array<string>",
      "mode_ids": "array<string>",
      "scope": "global|character|mixed"
    }
  },
  "creator_flow": {
    "phases": [
      "seed_capture",
      "clarify",
      "review",
      "done"
    ],
    "operation_types": [
      "create_character",
      "update_character",
      "update_modes",
      "mixed",
      "build_character_pack"
    ],
    "intent_matrix": {
      "character_create": "seed СЃРѕРґРµСЂР¶РёС‚ create/new/СЃРѕР·РґР°Р№/РЅРѕРІС‹Р№ Р±РµР· update -> create_character",
      "character_update": "seed СЃРѕРґРµСЂР¶РёС‚ update/change/РѕР±РЅРѕРІРё/РёР·РјРµРЅРё Р±РµР· create -> update_character",
      "mixed": "seed СЃРѕРґРµСЂР¶РёС‚ РѕРґРЅРѕРІСЂРµРјРµРЅРЅРѕ character + mode -> mixed",
      "ambiguous": "РµСЃР»Рё РёРЅС‚РµРЅС‚ РЅРµРѕС‡РµРІРёРґРµРЅ -> clarify РїРѕ operation_type"
    },
    "mode_scope_rules": {
      "mode_for_character": "РµСЃР»Рё РІ seed С„РѕСЂРјР°С‚ 'РґР»СЏ <character>' Рё РЅРµС‚ global -> scope=character",
      "mode_global_and_character": "РµСЃР»Рё РµСЃС‚СЊ Рё global, Рё 'РґР»СЏ <character>' -> scope=mixed",
      "target_required": "РїСЂРё scope=character|mixed studio РѕР±СЏР·Р°РЅР° Р·Р°РїСЂРѕСЃРёС‚СЊ target_character_id, РµСЃР»Рё РѕРЅ РЅРµ resolved"
    },
    "question_ux": {
      "numbered_choices": "1..N",
      "custom_choice": "0. Р’РІРµСЃС‚Рё СЃРІРѕР№ РІР°СЂРёР°РЅС‚",
      "impact_block": [
        "РР·РјРµРЅРёС‚",
        "Р¤Р°Р№Р»С‹",
        "Р”Р»СЏ РїРµСЂСЃРѕРЅР°Р¶Р°",
        "Р РµР·СѓР»СЊС‚Р°С‚"
      ]
    },
    "llm_profile": {
      "source": "config.model_config.PROFILES.keys()",
      "strict_enum": true,
      "allow_custom": false,
      "show_full_list": true
    }
  },
  "file_layout_contracts": [
    {
      "file": "data/specs/rules_for_all/taxonomy.json",
      "must_have_root_blocks": [
        "schema_version",
        "modes",
        "aliases"
      ],
      "required_nested_blocks": [
        "aliases.modes.chat",
        "aliases.modes.task",
        "aliases.modes.coding",
        "aliases.modes.debug"
      ]
    },
    {
      "file": "data/specs/rules_for_all/modes_spec.json",
      "must_have_root_blocks": [
        "schema_version",
        "modes"
      ],
      "required_nested_blocks": [
        "modes.<mode>.description",
        "modes.<mode>.legacy_mode",
        "modes.<mode>.output_format_default",
        "modes.<mode>.persona_effects"
      ]
    },
    {
      "file": "data/specs/rules_for_all/characters/{character_id}/character.json",
      "must_have_root_blocks": [
        "schema_version",
        "character_id",
        "id",
        "name",
        "default_mood",
        "default_mode",
        "llm_profile",
        "locks"
      ]
    },
    {
      "file": "data/specs/rules_for_all/characters/{character_id}/persona_state.json",
      "must_have_root_blocks": [
        "schema_version",
        "character_id",
        "name",
        "mood",
        "traits",
        "locks",
        "bans",
        "learned"
      ]
    },
    {
      "file": "data/specs/rules_for_all/characters/{character_id}/persona_spec.json",
      "must_have_root_blocks": [
        "schema_version",
        "identity",
        "locks_map",
        "bans_template",
        "moods",
        "modes",
        "traits_rules"
      ],
      "encoding_rule": "locks_map.informal_you РґРѕР»Р¶РµРЅ Р±С‹С‚СЊ СЂРѕРІРЅРѕ: Use informal address form ('С‚С‹')."
    },
    {
      "file": "data/specs/rules_for_all/characters/{character_id}/evolution_spec.json",
      "must_have_root_blocks": [
        "schema_version",
        "rules",
        "cleanup"
      ]
    }
  ],
  "apply_policy": {
    "json_strategy": "patch-merge",
    "preserve_unknown_fields": true,
    "remove_requires_explicit_intent": true,
    "create_update_mixed": {
      "always_write_specs": true,
      "always_write_blueprint": true,
      "always_write_artifacts": true,
      "files": [
        "character.json",
        "persona_state.json",
        "persona_spec.json",
        "evolution_spec.json",
        "studio_blueprint.json"
      ]
    },
    "update_modes": {
      "sync_global": [
        "data/specs/rules_for_all/taxonomy.json",
        "data/specs/rules_for_all/modes_spec.json"
      ],
      "sync_character_when_scope": "scope=character|mixed -> sync persona_spec target character"
    }
  },
  "tests": {
    "must_cover": [
      "create_character_explicit_intent_no_redundant_action_question",
      "update_character_explicit_intent_existing_candidates",
      "target_character_id_create_smart_candidates",
      "target_character_id_update_ranked_existing",
      "llm_profile_full_dynamic_enum_no_custom",
      "impact_block_verbose_for_character_steps",
      "create_apply_writes_specs_and_blueprint",
      "update_apply_patch_merge_preserves_unknown_fields",
      "mode_add_intent_does_not_ask_add_or_update_again_when_explicit",
      "studio_apply_cancel_local_short_circuit",
      "short_apply_cancel_local_short_circuit",
      "post_apply_next_chat_goes_main_model",
      "negative_apply_missing_fields_keeps_studio_active",
      "removed_specs_and_studio_mode_commands_return_removed_message",
      "utf8_strings_no_mojibake_in_help_and_studio_messages"
    ]
  },
  "definition_of_done": {
    "rules": [
      "Studio commands and lifecycle СЃРѕРѕС‚РІРµС‚СЃС‚РІСѓСЋС‚ public contract",
      "apply/cancel Р»РѕРєР°Р»СЊРЅС‹ Рё РЅРµ РґРѕС…РѕРґСЏС‚ РґРѕ main-model prompt",
      "creator РІ auto-first СЂРµР¶РёРјРµ Р·Р°РґР°РµС‚ С‚РѕР»СЊРєРѕ РЅРµРѕР±С…РѕРґРёРјС‹Рµ СѓС‚РѕС‡РЅРµРЅРёСЏ",
      "llm_profile СЃС‚СЂРѕРіРѕ РІР°Р»РёРґРёСЂСѓРµС‚СЃСЏ РїРѕ dynamic enum",
      "create/update/mixed РІСЃРµРіРґР° СЃРѕР·РґР°СЋС‚ specs + blueprint + artifacts",
      "С‚РµСЃС‚С‹ РёР· СЂР°Р·РґРµР»Р° tests РїРѕРєСЂС‹РІР°СЋС‚ РєСЂРёС‚РёС‡РµСЃРєРёРµ СЃС†РµРЅР°СЂРёРё"
    ]
  }
}

