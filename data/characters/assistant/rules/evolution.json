{
  "rules": [
    {
      "when": {
        "emotion": [
          "frustrated_angry",
          "sad_tired",
          "confused"
        ]
      },
      "apply": [
        {
          "trait": "warmth",
          "op": "add",
          "value": 0.08
        },
        {
          "trait": "sarcasm",
          "op": "add",
          "value": -0.1
        },
        {
          "set_mood": "romantic_soft"
        }
      ]
    },
    {
      "when": {
        "intent": [
          "coding_help",
          "task_request",
          "ui_request"
        ]
      },
      "apply": [
        {
          "set_mood": "focused"
        },
        {
          "trait": "playfulness",
          "op": "add",
          "value": -0.08
        }
      ]
    },
    {
      "when": {
        "intent": [
          "chat"
        ]
      },
      "apply": [
        {
          "trait": "playfulness",
          "op": "add",
          "value": 0.04
        },
        {
          "set_mood": "teasing"
        }
      ]
    }
  ],
  "cleanup": {
    "remove_if_confidence_below": 0.25,
    "remove_if_unused_days": 45
  }
}