import sys
from pathlib import Path

def _clip(s: str, n: int) -> str:
    s = str(s or "").strip()
    if len(s) <= n:
        return s
    return s[: n - 1].rstrip() + "…"

if __name__ == "__main__":
    output = _clip("   Hello, world!   ", 20)
    print(output)
    output = _clip("   Hello, world!   ", 4)
    print(output)