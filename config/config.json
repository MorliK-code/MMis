    "paths": {
      "input_dir": "{dir_path}\\data\\memory_storage\\voice\\input",
      "output_dir": "{dir_path}\\data\\memory_storage\\voice\\output"
    }
  },
  "logging": {
    "level": "INFO",
    "file": "",
    "colors": true,
    "max_bytes": 10485760,
    "backup_count": 5,
    "format": "%(asctime)s | %(levelname)s | %(name)s | %(message)s",
    "channels": {
      "llm": [
        "llm"
      ],
      "memory": [
        "memory",
        "metadata"
      ],
      "tools": [
        "modules",
        "tools"
      ],
      "ui": [
        "ui",
        "api",
        "ui_console",
        "ui_pyside6"
      ],
      "web": [
        "web",
        "core.web_rag_stage",
        "tools.modules.internet"
      ]
    },
    "web_trace_enabled": true,
    "web_trace_logger": "web.trace"
  },
